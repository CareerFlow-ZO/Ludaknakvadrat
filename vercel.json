{
  "version": 2,
  "headers": [
    {
      "source": "/previews/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/euro-gurman-preview/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/drone-records-sarajevo-preview/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^www\\\\.lnkdigital\\\\.com$"
        }
      ],
      "destination": "https://lnkdigital.com/:path*",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/index.html"
    },
    {
      "src": "^/index\\.html$",
      "has": [
        {
          "type": "host",
          "value": "eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/index.html"
    },
    {
      "src": "^/admin\\.html$",
      "has": [
        {
          "type": "host",
          "value": "eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/admin.html"
    },
    {
      "src": "^/euro-gurman-logo\\.svg$",
      "has": [
        {
          "type": "host",
          "value": "eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/euro-gurman-logo.svg"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "www.eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/index.html"
    },
    {
      "src": "^/index\\.html$",
      "has": [
        {
          "type": "host",
          "value": "www.eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/index.html"
    },
    {
      "src": "^/admin\\.html$",
      "has": [
        {
          "type": "host",
          "value": "www.eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/admin.html"
    },
    {
      "src": "^/euro-gurman-logo\\.svg$",
      "has": [
        {
          "type": "host",
          "value": "www.eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/euro-gurman-logo.svg"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "^lnkdigital\\\\.com$"
        }
      ],
      "dest": "/lnk-digital-home.html"
    },
    {
      "src": "^/sitemap\\\\.xml$",
      "has": [
        {
          "type": "host",
          "value": "^lnkdigital\\\\.com$"
        }
      ],
      "dest": "/lnk-sitemap.xml"
    },
    {
      "src": "^/robots\\\\.txt$",
      "has": [
        {
          "type": "host",
          "value": "^lnkdigital\\\\.com$"
        }
      ],
      "dest": "/lnk-robots.txt"
    }
  ]
}
