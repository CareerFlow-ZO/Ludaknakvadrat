  "routes": [
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "www.eurogurman.si"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://eurogurman.si/$1"
      }
    },
    {
      "src": "^/index\\.html$",
      "has": [
        {
          "type": "host",
          "value": "eurogurman.si"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://eurogurman.si/"
      }
    },
    {
      "src": "^/robots\\.txt$",
      "has": [
        {
          "type": "host",
          "value": "eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/robots.txt"
    },
    {
      "src": "^/sitemap\\.xml$",
      "has": [
        {
          "type": "host",
          "value": "eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/sitemap.xml"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/index.html"
    },
    {
      "src": "^/index\\.html$",
      "has": [
        {
          "type": "host",
          "value": "eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/index.html"
    },
    {
      "src": "^/admin\\.html$",
      "has": [
        {
          "type": "host",
          "value": "eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/admin.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "^/euro-gurman-logo\\.svg$",
      "has": [
        {
          "type": "host",
          "value": "eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/euro-gurman-logo.svg"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "www.eurogurman.si"
        }
      ],
      "dest": "/euro-gurman-preview/index.html"
    },
